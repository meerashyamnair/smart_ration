# ==========================================
# Smart Ration Distribution System Environment Variables
# ==========================================

# Core Server Settings
NODE_ENV=development
PORT=5000

# Frontend API URL Endpoint
VITE_API_URL=http://localhost:5000/api

# Database Connection URL (PostgreSQL Production / Docker default)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_ration_db?schema=public"

# Alternative SQLite local development URL (Used for fast local development)
# DATABASE_URL="file:./dev.db"

# JWT Authentication Configuration
# IMPORTANT: In production, generate a strong random 256-bit secret string!
JWT_SECRET=super_secret_jwt_key_smart_ration_pds_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Client App Origin)
CORS_ORIGIN=http://localhost:5173

# Optional Third-Party Notification Service Stubs (SMS / Email)
# SMS_PROVIDER_API_KEY=your_sms_api_key_here
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
